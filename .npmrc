legacy-peer-deps=true

# React Native / Expo: Metro cannot resolve through pnpm's symlinked node_modules.
# "hoisted" gives a flat npm-style layout that Metro understands, while files are
# still hardlinked from the global pnpm store - so the disk saving is unchanged.
node-linker=hoisted
strict-peer-dependencies=false  # pnpm equivalent of npm legacy-peer-deps above
